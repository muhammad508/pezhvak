<?xml version="1.0" encoding="utf-8"?>
<!--
    User-facing strings of the native side (notifications and diagnostics entries).
    The app is Persian-only, so Persian is the default and only locale. Keys are English.
-->
<resources>
    <string name="app_display_name">پژواک</string>

    <!-- Foreground service -->
    <string name="fg_channel_name">سرویس پایش</string>
    <string name="fg_title">سرویس فعال</string>
    <string name="fg_text">برنامه در حال بررسی نوتیفیکیشن‌ها است.</string>

    <!-- Test alarm -->
    <string name="test_alarm_title">آلارم آزمایشی</string>
    <string name="test_alarm_text">اگر این صفحه را می‌بینید و صدا پخش می‌شود، آلارم درست کار می‌کند ✅</string>

    <!-- Service-health alerts (ServiceWatchdog) -->
    <string name="alert_channel_name">هشدار توقف سرویس</string>
    <string name="alert_channel_description">وقتی پایش نوتیفیکیشن‌ها متوقف شود به شما خبر می‌دهد</string>
    <string name="alert_access_revoked_title">دسترسی خواندن اعلان‌ها قطع شده</string>
    <string name="alert_access_revoked_text">پژواک بدون این دسترسی نمی‌تواند آلارم بزند. برای فعال کردن دوباره بزنید.</string>
    <string name="alert_stopped_title">پایش نوتیفیکیشن‌ها متوقف شده</string>
    <string name="alert_stopped_text">تا فعال شدن دوباره، آلارم‌ها کار نمی‌کنند. برای بازیابی، برنامه را باز کنید.</string>

    <!-- Daily summary -->
    <string name="summary_channel_name">خلاصه‌ی روزانه</string>
    <string name="summary_channel_description">گزارش کوتاه شبانه از کارکرد پژواک</string>
    <string name="summary_title">خلاصه‌ی امروز پژواک</string>
    <string name="summary_text">امروز %1$d نوتیفیکیشن بررسی شد و %2$d آلارم زد.</string>
    <string name="summary_listener_down">⚠️ پایش نوتیفیکیشن‌ها الان قطع است؛ برنامه را باز کنید.</string>

    <!-- Silent matches -->
    <string name="silent_channel_name">موارد بی‌صدا</string>
    <string name="silent_channel_description">نوتیفیکیشن‌هایی که با قانون «بی‌صدا» جور شدند</string>
    <string name="silent_unknown_app">یک برنامه</string>
    <string name="silent_text_hidden">متن نوتیفیکیشن مخفی است</string>

